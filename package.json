{
  "name": "fbtv",
  "version": "0.2.0",
  "private": true,
  "description": "FBTV \u2014 a Google TV\u2013inspired IPTV app for LG webOS, with a catalogue builder for public IPTV metadata.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs",
    "catalogue": "node src/builder/main.ts",
    "catalogue:probe": "node src/builder/main.ts --probe",
    "library:refresh": "node src/library/main.ts refresh",
    "library:validate": "node src/library/main.ts validate",
    "library:report": "node src/library/main.ts report",
    "library:secret": "node src/library/main.ts secret",
    "library:xtream": "node src/library/main.ts xtream",
    "library:rebuild": "node src/library/main.ts rebuild",
    "library:fixtures": "node src/library/main.ts fixtures",
    "library:export": "node src/library/main.ts export",
    "library:serve": "node src/library/main.ts serve",
    "library:cleanup": "node src/library/main.ts cleanup"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@preact/signals": "2.11.3",
    "hls.js": "1.7.3",
    "mpegts.js": "1.8.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
